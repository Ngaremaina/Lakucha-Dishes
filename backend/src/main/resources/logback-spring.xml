<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local/dev (default profile, no PROD): human-readable console output.
  Render deployment (SPRING_PROFILES_ACTIVE=prod): one JSON object per line on stdout, which
  is what lets Render's log pipeline (or anything downstream of it) parse/query/aggregate
  fields instead of grepping free text.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <customFields>{"application":"lakucha-backend"}</customFields>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
